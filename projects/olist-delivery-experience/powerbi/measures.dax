// Olist delivery experience: DAX measures
// ------------------------------------------------------------------
// Model (load with powerquery.m; tables in ../data/sample/):
//   fact_route_month         month, seller_state, customer_state     + additive counts and sums
//   fact_category_month      month, category (primary category)      + additive counts and sums
//   fact_item_revenue_month  month, category (item category), is_delivered_order + items, price, freight
//   fact_delay_review        month, delay_bucket, review_score        + orders
//   fact_customer_cohort     month (first purchase)                   + customers, returned_*
//   dim_month, dim_customer_state, dim_seller_state, dim_category, dim_delay_bucket
// Relationships (all many-to-one, single direction, dimension filters fact):
//   fact_route_month[month]            -> dim_month[month]
//   fact_route_month[customer_state]   -> dim_customer_state[customer_state]
//   fact_route_month[seller_state]     -> dim_seller_state[seller_state]
//   fact_category_month[month]         -> dim_month[month]
//   fact_category_month[category]      -> dim_category[category]
//   fact_item_revenue_month[month]     -> dim_month[month]
//   fact_item_revenue_month[category]  -> dim_category[category]
//   fact_delay_review[month]           -> dim_month[month]
//   fact_delay_review[delay_bucket]    -> dim_delay_bucket[delay_bucket]
//   fact_customer_cohort[month]        -> dim_month[month]
// Sort dim_month[month_name] by month_number and dim_delay_bucket[label] by sort_order.
//
// Rules
// * Every rate is a ratio of sums (DIVIDE(SUM(numerator), SUM(denominator))).
//   No measure averages a rate, and no visual should use an implicit sum of a
//   rate column. Hide the raw numeric columns so they can't be dragged in.
// * Averages are rebuilt from *_sum and count columns, so they stay correct at
//   any level of the hierarchy.
// * Category slicers filter fact_category_month and fact_item_revenue_month
//   only; route and state slicers filter fact_route_month only. The facts are
//   aggregated separately to keep the published CSVs small (see README.md).
//
// Status: written against the CSV schema. The Python export recomputes the
// headline measures from the same CSVs (outputs/powerbi_expected_values.csv)
// and they match the pipeline. The DAX itself has not been run in Power BI
// Desktop yet.

// ---- Parameters --------------------------------------------------------------

Min Group Orders = 100

Wilson Z = 1.96

// ---- Volume and timing (fact_route_month) --------------------------------------

Orders =
    SUM ( fact_route_month[orders] )

// Delivered orders with both delivery and estimated dates: the timing population.
Delivered Orders =
    SUM ( fact_route_month[delivered_orders] )

Orders Outside Timing =
    [Orders] - [Delivered Orders]

Delivered Missing Date Orders =
    SUM ( fact_route_month[delivered_missing_date_orders] )

Late Orders =
    SUM ( fact_route_month[late_orders] )

On-Time Orders =
    [Delivered Orders] - [Late Orders]

Late Rate =
    DIVIDE ( [Late Orders], [Delivered Orders] )

On-Time Rate =
    DIVIDE ( [On-Time Orders], [Delivered Orders] )

Avg Days vs Estimate =
    DIVIDE ( SUM ( fact_route_month[days_vs_estimate_sum] ), [Delivered Orders] )

Avg Promised Days =
    DIVIDE ( SUM ( fact_route_month[promised_days_sum] ), [Delivered Orders] )

Avg Actual Days =
    DIVIDE ( SUM ( fact_route_month[actual_days_sum] ), [Delivered Orders] )

Avg Padding Days =
    [Avg Promised Days] - [Avg Actual Days]

// 95% Wilson score interval for the late rate in the current filter context.
Late Rate Low 95 =
    VAR n = [Delivered Orders]
    VAR p = [Late Rate]
    VAR z = [Wilson Z]
    RETURN
        IF (
            n > 0,
            ( p + z * z / ( 2 * n ) - z * SQRT ( p * ( 1 - p ) / n + z * z / ( 4 * n * n ) ) )
                / ( 1 + z * z / n )
        )

Late Rate High 95 =
    VAR n = [Delivered Orders]
    VAR p = [Late Rate]
    VAR z = [Wilson Z]
    RETURN
        IF (
            n > 0,
            ( p + z * z / ( 2 * n ) + z * SQRT ( p * ( 1 - p ) / n + z * z / ( 4 * n * n ) ) )
                / ( 1 + z * z / n )
        )

// Late rate shown only for groups with enough orders; use in tables that rank routes.
Late Rate (min orders) =
    IF ( [Delivered Orders] >= [Min Group Orders], [Late Rate] )

// ---- Shares and excess (routes and states) ----------------------------------------

Delivered Orders (all routes) =
    CALCULATE ( [Delivered Orders], REMOVEFILTERS ( dim_seller_state ), REMOVEFILTERS ( dim_customer_state ) )

Late Orders (all routes) =
    CALCULATE ( [Late Orders], REMOVEFILTERS ( dim_seller_state ), REMOVEFILTERS ( dim_customer_state ) )

Share of Delivered Orders =
    DIVIDE ( [Delivered Orders], [Delivered Orders (all routes)] )

Share of Late Orders =
    DIVIDE ( [Late Orders], [Late Orders (all routes)] )

// Late orders above what the group would have at the overall late rate.
Excess Late Orders =
    [Late Orders] - [Delivered Orders] * DIVIDE ( [Late Orders (all routes)], [Delivered Orders (all routes)] )

// ---- Time series ------------------------------------------------------------------------

// Volume-weighted three-month late rate ending at the latest month in context.
Late Rate 3M =
    VAR CurrentStart = MAX ( dim_month[month_start] )
    VAR Window =
        FILTER (
            ALL ( dim_month ),
            dim_month[month_start] > EDATE ( CurrentStart, -3 )
                && dim_month[month_start] <= CurrentStart
        )
    RETURN
        CALCULATE ( [Late Rate], Window )

Late Rate Change vs Prior Month =
    VAR CurrentStart = MAX ( dim_month[month_start] )
    VAR Prior =
        CALCULATE ( [Late Rate], FILTER ( ALL ( dim_month ), dim_month[month_start] = EDATE ( CurrentStart, -1 ) ) )
    RETURN
        IF ( NOT ISBLANK ( Prior ), [Late Rate] - Prior )

// ---- Reviews (fact_route_month) ------------------------------------------------------------

Reviewed Orders =
    SUM ( fact_route_month[reviewed_orders] )

Avg Review Score =
    DIVIDE ( SUM ( fact_route_month[review_score_sum] ), [Reviewed Orders] )

Avg Review Score (Late) =
    DIVIDE ( SUM ( fact_route_month[late_review_score_sum] ), SUM ( fact_route_month[late_reviewed_orders] ) )

Avg Review Score (On Time) =
    DIVIDE (
        SUM ( fact_route_month[review_score_sum] ) - SUM ( fact_route_month[late_review_score_sum] ),
        [Reviewed Orders] - SUM ( fact_route_month[late_reviewed_orders] )
    )

Review Score Gap (Late - On Time) =
    [Avg Review Score (Late)] - [Avg Review Score (On Time)]

% 1-Star (Late) =
    DIVIDE ( SUM ( fact_route_month[late_one_star_reviews] ), SUM ( fact_route_month[late_reviewed_orders] ) )

% 1-Star (On Time) =
    DIVIDE (
        SUM ( fact_route_month[one_star_reviews] ) - SUM ( fact_route_month[late_one_star_reviews] ),
        [Reviewed Orders] - SUM ( fact_route_month[late_reviewed_orders] )
    )

Late Share of 1-Star Reviews =
    DIVIDE ( SUM ( fact_route_month[late_one_star_reviews] ), SUM ( fact_route_month[one_star_reviews] ) )

// ---- Reviews by delay bucket (fact_delay_review) -----------------------------------------------

Delay Orders =
    SUM ( fact_delay_review[orders] )

Delay Reviewed Orders =
    CALCULATE ( SUM ( fact_delay_review[orders] ), NOT ISBLANK ( fact_delay_review[review_score] ) )

Avg Review Score by Delay =
    DIVIDE (
        SUMX ( fact_delay_review, fact_delay_review[review_score] * fact_delay_review[orders] ),
        [Delay Reviewed Orders]
    )

% 1-Star by Delay =
    DIVIDE ( CALCULATE ( SUM ( fact_delay_review[orders] ), fact_delay_review[review_score] = 1 ), [Delay Reviewed Orders] )

// ---- Categories (fact_category_month, primary category per order) --------------------------------

Category Delivered Orders =
    SUM ( fact_category_month[delivered_orders] )

Category Late Orders =
    SUM ( fact_category_month[late_orders] )

Category Late Rate =
    DIVIDE ( [Category Late Orders], [Category Delivered Orders] )

Category Late Rate (min orders) =
    IF ( [Category Delivered Orders] >= [Min Group Orders], [Category Late Rate] )

Category Share of Late Orders =
    DIVIDE ( [Category Late Orders], CALCULATE ( [Category Late Orders], REMOVEFILTERS ( dim_category ) ) )

Category Avg Review Score =
    DIVIDE ( SUM ( fact_category_month[review_score_sum] ), SUM ( fact_category_month[reviewed_orders] ) )

// ---- Revenue context (item price + freight; no costs, so no margin) -----------------------------------

Item Revenue (Delivered Orders) =
    CALCULATE ( SUM ( fact_item_revenue_month[item_revenue] ), fact_item_revenue_month[is_delivered_order] = TRUE () )

Freight (Delivered Orders) =
    CALCULATE ( SUM ( fact_item_revenue_month[freight] ), fact_item_revenue_month[is_delivered_order] = TRUE () )

Freight Share of Revenue =
    DIVIDE ( [Freight (Delivered Orders)], [Item Revenue (Delivered Orders)] )

Category Revenue Share =
    DIVIDE ( [Item Revenue (Delivered Orders)], CALCULATE ( [Item Revenue (Delivered Orders)], REMOVEFILTERS ( dim_category ) ) )

Item Revenue (All Orders) =
    SUM ( fact_route_month[item_revenue] )

Payments (All Orders) =
    SUM ( fact_route_month[payment_total] )

// Mostly payments on canceled / unavailable orders that have no items, plus instalment interest.
Payments minus Item Revenue =
    [Payments (All Orders)] - [Item Revenue (All Orders)]

// ---- Customers (fact_customer_cohort; customer_unique_id) --------------------------------------------

Cohort Customers =
    SUM ( fact_customer_cohort[customers] )

// Share of customers with delivered orders on two or more purchase days.
Repeat Customer Rate =
    DIVIDE ( SUM ( fact_customer_cohort[returned_any] ), [Cohort Customers] )

// Only cohorts with a full 180 days of data after their first month.
Return Rate 180d =
    CALCULATE (
        DIVIDE ( SUM ( fact_customer_cohort[returned_180d] ), SUM ( fact_customer_cohort[customers] ) ),
        fact_customer_cohort[full_180d_followup] = TRUE ()
    )
