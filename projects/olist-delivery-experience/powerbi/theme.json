{
  "name": "Billal Zughbi Portfolio Dark - Olist",
  "dataColors": [
    "#2B9FD0",
    "#E0703A",
    "#9085E9",
    "#3FCF8E",
    "#F2B84B",
    "#7A84A6"
  ],
  "background": "#0A0F1C",
  "foreground": "#E9EDFF",
  "tableAccent": "#4FD8FF",
  "good": "#3FCF8E",
  "neutral": "#F2B84B",
  "bad": "#E0703A",
  "maximum": "#E0703A",
  "center": "#7A84A6",
  "minimum": "#2B9FD0",
  "textClasses": {
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#AAB3D3"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#E9EDFF"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#E9EDFF"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#E9EDFF"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0A0F1C"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E2846"
              }
            },
            "radius": 10
          }
        ],
        "categoryAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#1A2240"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#7A84A6"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#1A2240"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#7A84A6"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#05070D"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
