# Copy to .env.local (git-ignored). No secrets are needed to build this site.

# Public URL of the deployed site, used for canonical links, Open Graph and the
# sitemap. Leave unset until the site has a real domain.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Base path when hosting on a GitHub Pages project URL.
# NEXT_PUBLIC_BASE_PATH=/data-analytics-portfolio
